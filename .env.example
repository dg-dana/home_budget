# Port the API server listens on (also serves the built frontend in production)
PORT=4000

# Secret used to sign session cookies. MUST be set to a long random value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production

# Where the SQLite database file lives, relative to the repo root
DATABASE_PATH=data/home-budget.sqlite

# Set to "production" when deploying
NODE_ENV=development

# ---------------------------------------------------------------------------
# Email. All optional: with no RESEND_API_KEY nothing is sent and every link is
# shown on screen instead, which is a permanently supported state (and how the
# test suite runs). The exception is "Forgotten your password?" — being
# unauthenticated, it refuses rather than printing a link anybody could use.
# ---------------------------------------------------------------------------

# The domain the app is served on. MAIL_FROM and APP_URL are derived from it,
# so in production this plus RESEND_API_KEY is the whole configuration.
# DOMAIN=example.com

# API key from https://resend.com. Setting it turns sending on.
# RESEND_API_KEY=

# Only needed to override what DOMAIN gives you.
# MAIL_FROM=Home Budget <noreply@example.com>
# APP_URL=https://example.com
